# انسخ هذا الملف إلى .env ثم ضع القيم الحقيقية — لا تضع أسرارًا في المستودع إطلاقًا

# إلزاميان — قاعدة Turso (أنشئها مجانًا عبر turso db create)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# اختياري — عنوان النطاق العام للبناء روابط النتائج (يُستنتج تلقائيًا من الطلب إن تُرك فارغًا)
MERGER_PUBLIC_BASE=

# اختياري — الحدود القابلة للضبط
MAX_SOURCES=10
SOURCE_MAX_MB=200
OUTPUT_MAX_MB=150
MAX_TOTAL_DURATION_SEC=600
FFMPEG_PRESET=medium
UPLOAD_CHUNK_BYTES=4194304
