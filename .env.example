# انسخ هذا الملف إلى .env محليًا (أو أضف القيم في Vercel → Settings → Environment Variables)
# لا تضع أسرارًا حقيقية في هذا الملف ولا ترفعه إلى Git إطلاقًا (.env* مستثنى منذ أول commit)

# ————— إلزاميان: قاعدة Turso (libSQL عبر HTTP) —————
# أنشئ قاعدة مجانية: turso db create <name> ثم:
#   رابط القاعدة:    turso db show <name> --url
#   توكن الكتابة:    turso db tokens create <name>
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<Turso token بصلاحيات كتابة>

# ————— خدمة دمج الفيديو —————
# نطاق خدمة الدمج المنشورة (مشروع Vercel ثانٍ من مجلد merger/ في نفس المستودع)
# مثال: https://video-merger-api.vercel.app
MERGER_API_BASE=

# ————— اختياري —————
# إن ضُبط يُطلب Authorization: Bearer <token> على /mcp (يظهر في الواجهة و health)
MCP_ACCESS_TOKEN=

# تجاوز أسماء الموديلات إن لزم (الافتراضيات مدمجة)
# KIE_IMAGE_MODEL=gpt-image-2-6/flare-text-to-image
# KIE_VIDEO_MODEL=grok-imagine-video-1-5-preview
# COMETAPI_IMAGE_MODEL=gpt-image-2.6-flare-text-to-image
# COMETAPI_VIDEO_MODEL=grok-imagine-video-1-5-preview
