// مخطط مصغر غير مستخدم — التطبيق نفسه يعمل عبر Turso (@libsql/client) حسب المواصفة.
// هذا الملف موجود فقط ليتمرر أنبوب التهيئة المحلي (db:push) بنجاح.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./../db/custom.db"
}

model Placeholder {
  id    String @id @default(cuid())
  done  Boolean @default(false)
}
